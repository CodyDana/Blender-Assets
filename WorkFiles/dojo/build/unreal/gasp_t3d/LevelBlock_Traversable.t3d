      Begin Object Name="EdGraphNode_Comment_1" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/Levels/LevelPrototyping/LevelBlock_Traversable.LevelBlock_Traversable:GetLedgeTransforms.EdGraphNode_Comment_1'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=1743
         NodePosY=-318
         NodeWidth=1248
         NodeHeight=352
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Make sure the ledge is wide enough. If not, the front ledge will not be valid."
         NodeGuid=DF10F6894612CDD2B883BB97659A5CC4
      End Object
      Begin Object Name="EdGraphNode_Comment_2" ExportPath="/Script/UnrealEd.EdGraphNode_Comment'/Game/Levels/LevelPrototyping/LevelBlock_Traversable.LevelBlock_Traversable:GetLedgeTransforms.EdGraphNode_Comment_2'"
         bCommentBubbleVisible_InDetailsPanel=False
         NodePosX=3024
         NodePosY=-320
         NodeWidth=2192
         NodeHeight=512
         bCommentBubblePinned=False
         bCommentBubbleVisible=False
         NodeComment="Get the closest point on the ledge to the actor, and clamp the location so that it can\'t be too close to the end of the ledge. This prevents the character from floating if they traverse near a corner. The clamped location will always be half the \"min ledge width\" from the edge. If the min ledge width is 60 units, the ledge location will always be at least 30 units away from a corner."
         NodeGuid=7667B89A4422FBC7E381A88FAFE75EF6
      End Object
