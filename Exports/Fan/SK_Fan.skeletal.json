      "fps": 60,
      "loop": false,
      "playback": "NOT for playing: closed (0 s) to fully open (1.0 s), linear in the opening angle; drive it by explicit time (Sequence Evaluator, time = openness 0..1) for gameplay-controlled opening"
    },
